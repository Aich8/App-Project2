as="geometry" /></mxCell><mxCell id="no79" value="&lt;b&gt;History cleanup:&lt;/b&gt; при open и после каждого successful saved action; фонового таймера не требуется." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="870" y="2025" width="720" height="100" as="geometry" /></mxCell><mxCell id="no80" value="&lt;b&gt;Data integrity:&lt;/b&gt; broken history entry можно удалить локально; broken Saving остаётся видимым для Fix/Delete." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1650" y="2025" width="820" height="100" as="geometry" /></mxCell><mxCell id="no81" value="&lt;b&gt;Atomic UX:&lt;/b&gt; нельзя «притвориться», что действие сохранилось, если storage write не прошёл." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2530" y="2025" width="860" height="100" as="geometry" /></mxCell><mxCell id="t82" value="Основано только на Business Spec: Cash Money Organizer Website. Синие = команды, оранжевые = события, фиолетовые = правила/политики." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="50" y="2145" width="3500" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="05 — UI state machine" id="05_—_UI_state_machine"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3500" pageHeight="2100" math="0" shadow="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t2" val