&lt;b&gt;broken Saving пропускается&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b4a7d6;strokeColor=#8e7cc3;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2070" y="255" width="550" height="170" as="geometry" /></mxCell><mxCell id="no19" value="&lt;b&gt;Главный инвариант Savings&lt;/b&gt;&lt;br&gt;planned amount ≠ перевод денег.&lt;br&gt;Saving не уменьшает Current Balance и не создаёт Balance Changes.&lt;br&gt;Изменение Current Balance не меняет planned amounts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="2700" y="255" width="760" height="170" as="geometry" /></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ac13" target="co14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="co14" target="ev15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ev15" target="re16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ev15" target="re